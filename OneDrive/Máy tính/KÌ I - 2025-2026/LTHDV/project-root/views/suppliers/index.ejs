<%- include('../partials/header.ejs') %>

    <div class="d-flex justify-content-between align-items-center">
        <h2>Suppliers</h2>
        <a class="btn btn-primary" href="/suppliers/create">Create supplier</a>
    </div>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% suppliers.forEach(s => { %>
                <tr>
                    <td>
                        <%= s.name %>
                    </td>
                    <td>
                        <%= s.address %>
                    </td>
                    <td>
                        <%= s.phone %>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/suppliers/<%= s._id %>/edit">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/suppliers/<%= s._id %>/delete" onclick="return confirm('Delete?')">Delete</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <%- include('../partials/footer.ejs') %>