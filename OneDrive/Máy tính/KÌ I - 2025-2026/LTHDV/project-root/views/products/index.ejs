<%- include('../partials/header.ejs') %>

    <div class="d-flex justify-content-between align-items-center">
        <h2>Products</h2>
        <a class="btn btn-primary" href="/products/create">Create product</a>
    </div>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Supplier</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(p => { %>
                <tr>
                    <td>
                        <%= p.name %>
                    </td>
                    <td>
                        <%= p.price %>
                    </td>
                    <td>
                        <%= p.quantity %>
                    </td>
                    <td>
                        <%= p.supplier ? p.supplier.name : 'N/A' %>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/products/<%= p._id %>/edit">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/products/<%= p._id %>/delete" onclick="return confirm('Delete?')">Delete</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <%- include('../partials/footer.ejs') %>