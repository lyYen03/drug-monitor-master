<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supplier-Product App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">ProdSupplier</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
            <div id="nav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <% if (currentUser) { %>
                        <li class="nav-item"><a class="nav-link" href="/products">Products (Admin)</a></li>
                        <li class="nav-item"><a class="nav-link" href="/suppliers">Suppliers (Admin)</a></li>
                        <% } %>
                </ul>

                <ul class="navbar-nav">
                    <% if (currentUser) { %>
                        <li class="nav-item"><span class="navbar-text me-2">Hi, <%= currentUser.username %></span></li>
                        <li class="nav-item"><a class="nav-link" href="/auth/logout">Logout</a></li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
                            <li class="nav-item"><a class="nav-link" href="/auth/register">Register</a></li>
                            <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">