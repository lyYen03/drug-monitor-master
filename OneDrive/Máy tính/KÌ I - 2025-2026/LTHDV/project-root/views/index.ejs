<%- include('partials/header') %>

    <div class="row mb-3">
        <div class="col-md-8">
            <form class="d-flex" method="get" action="/">
                <input class="form-control me-2" name="q" placeholder="Search product by name" value="<%= q %>">
                <select class="form-select me-2" name="supplier">
        <option value="">All suppliers</option>
        <% suppliers.forEach(s => { %>
          <option value="<%= s._id %>" <%= selectedSupplier==s._id ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a href="/api-docs" class="btn btn-outline-secondary">API Docs</a>
        </div>
    </div>

    <div class="row">
        <% if (products.length === 0) { %>
            <p>No products found.</p>
            <% } %>
                <% products.forEach(p => { %>
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= p.name %>
                                </h5>
                                <p class="card-text">Price: <strong><%= p.price %></strong></p>
                                <p class="card-text">Quantity:
                                    <%= p.quantity %>
                                </p>
                                <p class="card-text">Supplier:
                                    <%= p.supplier ? p.supplier.name : 'N/A' %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <% }) %>
    </div>

    <%- include('partials/footer') %>